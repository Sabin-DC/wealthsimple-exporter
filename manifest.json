{
  "manifest_version": 3,
  "name": "Wealthsimple & AccèsD Exporter",
  "version": "0.1.1",
  "description": "Export Wealthsimple and visible AccèsD checking and credit card transactions locally.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "downloads"
  ],
  "host_permissions": [
    "https://*.wealthsimple.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://my.wealthsimple.com/*"
      ],
      "js": [
        "src/content/index.ts"
      ]
    },
    {
      "matches": [
        "https://accesdc.mouv.desjardins.com/*",
        "https://accesd.mouv.desjardins.com/*"
      ],
      "js": [
        "src/content/accesd.ts"
      ]
    }
  ],
  "background": {
    "scripts": [
      "src/background/index.ts"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "wealthsimple-exporter@sabin-dc.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
