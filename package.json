{
  "name": "wealthsimple-exporter",
  "version": "0.1.1",
  "private": true,
  "description": "Firefox extension to export Wealthsimple transactions to CSV/OFX/QFX",
  "homepage": "https://github.com/nicksalt/wealthsimple-exporter",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicksalt/wealthsimple-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/nicksalt/wealthsimple-exporter/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build.mjs",
    "build": "tsc && node scripts/build.mjs",
    "test": "vitest",
    "test:unit": "vitest run --exclude='**/e2e/**'",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "zip": "node zip.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/chrome": "^0.0.268",
    "@types/node": "^25.2.3",
    "@types/xml2js": "^0.4.14",
    "archiver": "^6.0.1",
    "dotenv": "^17.3.1",
    "jsdom": "^28.0.0",
    "otplib": "^13.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^4.0.18",
    "xml2js": "^0.6.2"
  }
}
